{
  "name": "@adalabs/agrotech-debug-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Field-capture-v2 debug/admin web client. Consumes the FastAPI on :8000 + ROS2 over rosbridge:9090.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "codegen": "bash ./scripts/codegen.sh"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roslib": "^1.4.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/roslib": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
